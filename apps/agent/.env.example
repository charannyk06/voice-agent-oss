# Core agent runtime
AGENT_NAME=Reception Desk
AGENT_ROLE=generic_business_frontdesk
AGENT_PORT=3012
MAX_CALL_DURATION_MIN=15
DATABASE_URL=file:../web/prisma/dev.db

# Deployment and dashboard security
# self_hosted allows local experiments. hosted enables production-style payment and token checks.
DEPLOYMENT_MODE=self_hosted
AGENT_DEFAULT_ORG_ID=default
AGENT_DASHBOARD_TOKEN_SECRET=
AGENT_MEDIA_STREAM_TOKEN_SECRET=
DASHBOARD_ALLOWED_ORIGINS=http://localhost:3011
REQUIRE_DASHBOARD_TOKEN=false
REQUIRE_WEBHOOK_SIGNATURES=false
INBOUND_ORG_ROUTES=twilio:+15555550100=default
TELEPHONY_STREAM_ALLOWED_IPS=
TELEPHONY_STREAM_ALLOWED_ORIGINS=

# Hosted billing usage ingest. Use the dashboard base URL or the full /api/billing/usage URL.
BILLING_USAGE_INGEST_URL=http://localhost:3011
BILLING_USAGE_INGEST_SECRET=

# Business identity
BUSINESS_NAME=Example Business
BUSINESS_LOCATION=123 Main Street, Springfield
BUSINESS_RECEPTION_NUMBER=+15555550100
URGENT_TRANSFER_NUMBER=+15555550100
BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=21:00

# Gemini Live. Self-hosters bring their own key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LANGUAGE_CODE=en-US
GEMINI_VOICE_NAME=Kore
GEMINI_INPUT_SAMPLE_RATE=16000
GEMINI_OUTPUT_SAMPLE_RATE=24000

# Optional STT or TTS providers
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Telephony provider: twilio, plivo, or asterisk
TELEPHONY_PROVIDER=twilio
TELEPHONY_PUBLIC_BASE_URL=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_PUBLIC_BASE_URL=
TWILIO_MEDIA_STREAM_URL=
TWILIO_WEBHOOK_PATH=/webhook/twilio

# Plivo
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=
PLIVO_PUBLIC_BASE_URL=
PLIVO_MEDIA_STREAM_URL=
PLIVO_ANSWER_PATH=/webhook/plivo/answer
PLIVO_STATUS_PATH=/webhook/plivo/status
# Hosted/prod Plivo webhooks use X-Plivo-Signature-V3 and X-Plivo-Signature-V3-Nonce.

# Asterisk
ASTERISK_ARI_BASE_URL=
ASTERISK_ARI_USERNAME=
ASTERISK_ARI_PASSWORD=
ASTERISK_ARI_APPLICATION=voice-agent
ASTERISK_SIP_DOMAIN=
ASTERISK_PJSIP_ENDPOINT=byoc-trunk
ASTERISK_PUBLIC_HOST=
ASTERISK_EXTERNAL_MEDIA_HOST=
ASTERISK_EXTERNAL_MEDIA_BIND_ADDRESS=0.0.0.0
ASTERISK_EXTERNAL_MEDIA_PORT=
ASTERISK_INBOUND_CONTEXT=voice-agent-inbound
ASTERISK_OUTBOUND_CONTEXT=voice-agent-outbound

# Optional external search connector
EXTERNAL_SEARCH_PROVIDER=
EXTERNAL_SEARCH_ENDPOINT=
EXTERNAL_SEARCH_API_KEY=
EXTERNAL_SEARCH_MODEL=
EXTERNAL_SEARCH_BASE_URL=
