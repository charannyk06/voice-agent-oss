# Web dashboard
DATABASE_URL=replace_with_postgres_database_url
NEXT_PUBLIC_APP_NAME=Voice Agent OSS
NEXT_PUBLIC_APP_URL=http://localhost:3011
PUBLIC_APP_URL=http://localhost:3011

# Deployment mode. Any Stripe or usage-ingest value forces hosted mode, even if this is accidentally left as self_hosted.
DEPLOYMENT_MODE=self_hosted
HOSTED_MONTHLY_INCLUDED_MINUTES=60
# Keep false for launch. Set true only if a Stripe trial should be allowed to spend hosted minutes.
HOSTED_ALLOW_TRIALING_USAGE=false

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace_with_clerk_publishable_key
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Agent API and WebSocket endpoints
AGENT_BASE_URL=http://localhost:3012
NEXT_PUBLIC_AGENT_URL=http://localhost:3012
NEXT_PUBLIC_WS_URL=ws://localhost:3012/ws
AGENT_DASHBOARD_TOKEN_SECRET=

# Only NEXT_PUBLIC_* values are sent to browsers. Never prefix secrets, tokens,
# database URLs, Stripe secret keys, or telephony credentials with NEXT_PUBLIC_.

# Internal usage ingest from the agent to the dashboard.
# Hosted mode requires X-Usage-Timestamp and X-Usage-Signature HMAC headers.
# Set the same value in apps/agent/.env when DEPLOYMENT_MODE=hosted.
BILLING_USAGE_INGEST_SECRET=

# Stripe hosted billing. Leave empty for self-hosted-only deployments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=price_replace_me

# Optional Stripe usage-based billing meter.
# Create the meter in Stripe first, then set its event name here.
STRIPE_METER_EVENT_NAME=voice_seconds
STRIPE_METER_CUSTOMER_KEY=stripe_customer_id
STRIPE_METER_VALUE_KEY=value
