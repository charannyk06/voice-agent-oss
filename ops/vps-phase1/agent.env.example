DATABASE_URL=replace_with_postgres_connection_url
GEMINI_API_KEY=<gemini-api-key>
TELEPHONY_PROVIDER=asterisk
AGENT_PORT=3012
DEPLOYMENT_MODE=self_hosted
INBOUND_ORG_ROUTES=asterisk:sip.example.com=default
TELEPHONY_STREAM_ALLOWED_IPS=
TELEPHONY_STREAM_ALLOWED_ORIGINS=

BUSINESS_NAME=Example Business
BUSINESS_LOCATION=123 Main Street, Springfield
BUSINESS_RECEPTION_NUMBER=+15551234567
URGENT_TRANSFER_NUMBER=+15551234567

ASTERISK_ARI_BASE_URL=http://127.0.0.1:8088/ari
ASTERISK_ARI_USERNAME=voice-agent
ASTERISK_ARI_PASSWORD=<asterisk-ari-password>
ASTERISK_ARI_APPLICATION=voice-agent
ASTERISK_SIP_DOMAIN=sip.example.com
ASTERISK_PJSIP_ENDPOINT=byoc-trunk
ASTERISK_INBOUND_CONTEXT=voice-agent-inbound
ASTERISK_OUTBOUND_CONTEXT=voice-agent-outbound
ASTERISK_EXTERNAL_MEDIA_HOST=127.0.0.1
ASTERISK_EXTERNAL_MEDIA_BIND_ADDRESS=0.0.0.0
ASTERISK_EXTERNAL_MEDIA_PORT=0
